APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8591

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=vct_analytics
TOURNAMENT_SLUG=valorant-champions-2026

LIQUIPEDIA_USER_AGENT=
LIQUIPEDIA_REQUEST_INTERVAL_SECONDS=2
LIQUIPEDIA_PARSE_INTERVAL_SECONDS=30
LIQUIPEDIA_CACHE_TTL_SECONDS=1800

AUTO_UPDATE_ENABLED=false
AUTO_UPDATE_MODE=interval
AUTO_UPDATE_INTERVAL_MINUTES=30
AUTO_UPDATE_DAILY_TIMES=
AUTO_UPDATE_TIMEZONE=Asia/Taipei
AUTO_UPDATE_RUN_ON_START=false
AUTO_UPDATE_MAX_SCHEDULE_WRITES=100
AUTO_UPDATE_MAX_STATS_WRITES=1000
AUTO_UPDATE_MAX_ASSET_WRITES=50
AUTO_UPDATE_MAX_SOURCE_DECREASE_PERCENT=25
AUTO_UPDATE_LOCK_STALE_MINUTES=60
AUTO_UPDATE_BACKOFF_MAX_MINUTES=30
